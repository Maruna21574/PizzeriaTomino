# Pizzeria Tominno - Apache konfigurácia pre zdieľaný hosting (webSupport a pod.)

DirectoryIndex index.php

ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jednotná adresa webu: https://www.pizzeriatominno.sk
  # Platí iba pre ostrú doménu - lokálny vývoj (napr. *.test v Laragone) ostáva bez zmeny.
  # X-Forwarded-Proto rieši hosting za proxy, kde %{HTTPS} býva "off" aj pri https.
  RewriteCond %{HTTP_HOST} ^(www\.)?pizzeriatominno\.sk$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://www.pizzeriatominno.sk%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^pizzeriatominno\.sk$ [NC]
  RewriteRule ^ https://www.pizzeriatominno.sk%{REQUEST_URI} [L,R=301]

  # Online objednávky a "Vlastná pizza" boli zrušené - staré odkazy presmerujeme na menu.
  RewriteRule ^(objednavka|vlastna-pizza|dakujeme)(\.php)?$ /menu [R=301,L]

  # Staré adresy s .php presmerujeme na pekné (/menu.php -> /menu, /index.php -> /).
  # Iba GET - POST z kontaktného formulára ide priamo na process_contact.php.
  RewriteCond %{REQUEST_METHOD} GET
  RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{REQUEST_METHOD} GET
  RewriteCond %{THE_REQUEST} !\s/+(process_contact|404)\.php [NC]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Maďarská verzia webu: /hu/ a /hu/menu -> tie isté PHP stránky, jazyk
  # sa určí z adresy (includes/functions.php, funkcia lang()).
  RewriteRule ^hu/?$ index.php [L]
  RewriteRule ^hu/(menu|menu-pdf|galeria|oslavy-a-akcie|o-nas|doprava-a-platba|kontakt|ochrana-osobnych-udajov)/?$ $1.php [L]

  # Pekné URL bez .php prípony, napr. /menu -> menu.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Skrytie citlivých priečinkov a súborov
<FilesMatch "\.(json|log|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
